# --- LLM (optional) ---------------------------------------------------------
# Leave LLM_API_KEY empty to run in offline "rules" mode (no cost, deterministic).
# Any OpenAI-compatible API works (OpenAI, Groq, OpenRouter, Ollama, LM Studio).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Ollama example: LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1

# --- Telegram alerts (optional) ----------------------------------------------
# Create a bot with @BotFather, then send it a message and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TIMEZONE=Europe/Istanbul
